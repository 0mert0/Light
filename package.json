{
  "name": "light-app",
  "version": "1.0.0",
  "description": "Light messaging app",
  "main": "server.js",
  "scripts": {
    "start": "node src/server.js",
    "app": "electron .",
    "build-win": "electron-builder --win"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
